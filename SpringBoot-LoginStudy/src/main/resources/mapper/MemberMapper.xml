<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.login_study.demo.mapper.MemberMapper">

    <!-- 1. save() 매핑 -->
    <insert id="save" parameterType="com.example.login_study.demo.entity.Member" useGeneratedKeys="true" keyProperty="memberId">
        INSERT INTO member (email, password, nickname, created_at)
        VALUES (#{email}, #{password}, #{nickname}, NOW())
    </insert>

    <!-- 2. findByEmail() 매핑 -->
    <select id="findByEmail" resultType="com.example.login_study.demo.entity.Member">
        SELECT member_id, email, password, nickname, created_at
        FROM member
        WHERE email = #{email}
    </select>

    <!-- 3. findByNickname() 매핑 -->
    <select id="findByNickname" resultType="com.example.login_study.demo.entity.Member">
        SELECT member_id, email, password, nickname, created_at
        FROM member
        WHERE nickname = #{nickname}
    </select>

    <!-- 4. findById() 매핑 (인터페이스 파라미터명이 memberId인지 id인지 확인) -->
    <select id="findByid" resultType="com.example.login_study.demo.entity.Member">
        SELECT * FROM member WHERE member_id = #{memberId}
    </select>

    <delete id="deleteByMemberId">
        DELETE FROM member WHERE member_id = #{memberId}
    </delete>

    <update id="update">
        UPDATE member
        SET nickname = #{nickname},
        password = #{password}
        WHERE member_id = #{memberId}
    </update>

</mapper>