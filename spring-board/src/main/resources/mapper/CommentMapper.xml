<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springboard.mapper.CommentMapper">

    <insert id="save" parameterType="com.example.springboard.entity.Comment" useGeneratedKeys="true" keyProperty="commentId">
        INSERT INTO comment (board_id, member_id, content, created_at)
        VALUES (#{boardId}, #{memberId}, #{content}, NOW());
    </insert>

</mapper>